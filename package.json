{
	"name": "amrap",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:owner": "playwright test --project=owner --project=owner-auth --project=provisional --project=owner-setup --project=provisional-setup",
		"test:e2e:staff": "playwright test --project=owner-setup --project=staff-setup --project=staff",
		"test:e2e:trainer": "playwright test --project=owner-setup --project=trainer-setup --project=trainer",
		"test:e2e:member": "playwright test --project=owner-setup --project=member-setup --project=member",
		"test:e2e:flows": "playwright test --project=owner-setup --project=multi-user",
		"test:e2e:billing": "playwright test e2e/owner/billing-stripe.spec.ts --project=owner-setup --project=owner",
		"stripe:sync-tax": "node --env-file=.env scripts/stripe-sync-catalog-tax.mjs",
		"knip": "knip"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/qrcode": "^1.5.6",
		"@vite-pwa/sveltekit": "^1.1.0",
		"dotenv": "^17.4.2",
		"knip": "^6.27.0",
		"sharp": "^0.35.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-pwa": "^1.3.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.24.0",
		"@stripe/stripe-js": "^9.12.0",
		"@supabase/ssr": "^0.12.3",
		"@supabase/supabase-js": "^2.110.7",
		"html5-qrcode": "^2.3.8",
		"qrcode": "^1.5.4",
		"resend": "^6.17.2",
		"stripe": "^22.3.2",
		"workbox-window": "^7.4.1",
		"zod": "^4.4.3"
	}
}